# --- Carpetas ocultas -------------------------------------------------------
# Proyecto de un solo autor: ninguna carpeta oculta sube al repo (.claude,
# .astro, .vscode, .idea...). Excepción: .github/ contiene el workflow que
# despliega la web en GitHub Pages y tiene que estar versionado.
.*/
!.github/

# --- Información sensible -----------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets.*
credentials.*
*.secret

# --- Notas locales para Claude Code -------------------------------------------
CLAUDE.md
CLAUDE.local.md

# --- Dependencias y build ----------------------------------------------------
node_modules/
dist/

# --- Logs ---------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- macOS --------------------------------------------------------------------
.DS_Store
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
