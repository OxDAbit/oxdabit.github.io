---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getCategoryCounts, getPosts } from '../../lib/content';

const posts = await getPosts();
const counts = await getCategoryCounts();
---

<BaseLayout title="Blog" description="Todas las entradas del blog: software, IA, hardware, impresión 3D y cosplay.">
  <BlogIndex posts={posts} counts={counts} total={posts.length} />
</BaseLayout>
