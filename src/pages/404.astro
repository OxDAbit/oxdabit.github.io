---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe." noindex>
  <section class="wrap pt-16 md:pt-24">
    <p class="annot">Error 404</p>
    <h1 class="display mt-5 text-[clamp(52px,8vw,128px)] max-w-[12ch]">Esta pieza no está en el plano</h1>
    <p class="mt-8 max-w-[44ch] text-[clamp(18px,1.4vw,22px)] leading-[1.5] text-ink/90">
      La dirección no existe o ha cambiado. Vuelve a la <a href="/" class="underline underline-offset-4">portada</a>
      o busca en el <a href="/blog" class="underline underline-offset-4">blog</a>.
    </p>
  </section>
</BaseLayout>
